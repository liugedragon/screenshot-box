<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <BaseIntermediateOutputPath Condition="$([MSBuild]::IsOSPlatform('Linux'))">obj/linux/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
