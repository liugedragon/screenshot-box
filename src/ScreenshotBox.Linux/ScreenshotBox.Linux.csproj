<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers><RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained><Version>0.1.5-linux.1</Version>
    <AssemblyName>ScreenshotBox.Linux</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <ProjectReference Include="../ScreenshotBox.Core/ScreenshotBox.Core.csproj" />
    <ProjectReference Include="../ScreenshotBox.Ocr/ScreenshotBox.Ocr.csproj" />
    <Compile Include="../ScreenshotBox.App/Native/SelectionGeometry.cs" Link="Native/SelectionGeometry.cs" />
    <AvaloniaResource Include="../../assets/screenshotbox.ico" Link="Assets/app.ico" />
    <Content Include="../../models/chinese/*" Link="models/chinese/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
