<Application x:Class="ScreenshotBox.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
 <ui:ThemesDictionary Theme="Light"/><ui:ControlsDictionary/>
 </ResourceDictionary.MergedDictionaries>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/></Style>
 <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="Foreground" Value="{DynamicResource SbText}"/><Setter Property="Background" Value="{DynamicResource SbSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource SbStroke}"/></Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="Foreground" Value="{DynamicResource SbText}"/><Setter Property="Background" Value="{DynamicResource SbSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource SbStroke}"/></Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource SbText}"/><Setter Property="Background" Value="{DynamicResource SbSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource SbStroke}"/></Style>
 <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}"><Setter Property="Appearance" Value="Secondary"/><Setter Property="Foreground" Value="{DynamicResource SbText}"/><Setter Property="Background" Value="{DynamicResource SbSurface}"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="32"/><Style.Triggers><Trigger Property="Appearance" Value="Primary"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource SbAccent}"/></Trigger></Style.Triggers></Style>
 <Style TargetType="ui:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}"><Setter Property="Foreground" Value="{DynamicResource SbText}"/><Setter Property="Background" Value="{DynamicResource SbSurface}"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
